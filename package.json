{
  "name": "quizmeadow",
  "version": "1.1.0",
  "description": "An offline quiz app for growing what you know. Free and open source.",
  "author": "Bruno",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run notices && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate-library.ts",
    "schema": "tsx scripts/generate-schema.ts",
    "package:mac": "npm run build && electron-builder --mac dir --arm64",
    "check": "npm run typecheck && npm test && npm run validate -- library",
    "test:desktop": "npm run build && node tests/desktop.mjs",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64 --x64 && npm run verify:mac",
    "notices": "node scripts/generate-notices.mjs",
    "verify:mac": "node scripts/verify-mac-archives.mjs",
    "icon": "node scripts/export-icon.mjs",
    "test:visual": "npm run build && node tests/visual.mjs",
    "test:packaged": "node tests/packaged.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.577.0",
    "motion": "^13.4.4",
    "playwright": "^1.58.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "io.github.bilgon32.quizmeadow",
    "productName": "QuizMeadow",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "library",
        "to": "starter-library"
      },
      {
        "from": "docs",
        "to": "docs"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "identity": "-",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "artifactName": "QuizMeadow-mac-${arch}.${ext}",
      "notarize": false,
      "strictVerify": true
    },
    "afterSign": "scripts/verify-mac-signature.cjs"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
